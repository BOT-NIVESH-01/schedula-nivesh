generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?

  recurringAvailabilities RecurringAvailability[]
  customAvailabilities    CustomAvailability[]
}

model DoctorProfile {
  id              Int     @id @default(autoincrement())
  specialization  String
  experience      Int
  qualification   String
  consultationFee Float
  availability    String
  profileDetails  String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id                Int     @id @default(autoincrement())
  age               Int
  gender            Gender
  contactDetails    String
  healthInformation String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringAvailability {
  id        Int       @id @default(autoincrement())
  dayOfWeek DayOfWeek
  startTime DateTime
  endTime   DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomAvailability {
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime DateTime
  endTime   DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}